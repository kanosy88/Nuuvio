    <string name="letterboxd_cookies_label">Cookies</string>
    <string name="letterboxd_cookies_help">Sign in to letterboxd.com in your browser, open the developer tools (Network tab), reload the page, select the request to letterboxd.com and copy the whole “Cookie” request header. A Cookie-Editor JSON export or a cookies.txt file also works. It must include the session cookie letterboxd.user.CURRENT (or letterboxd.user), and ideally com.xk72.webparts.csrf and cf_clearance.</string>
    <string name="letterboxd_user_agent_label">User-Agent (optional)</string>
    <string name="letterboxd_user_agent_help">Paste the exact User-Agent of the browser the cookies come from (same request headers, or type navigator.userAgent in the console). Cloudflare ties cf_clearance to it.</string>
